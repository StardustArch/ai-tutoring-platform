// 1. Configuração do Cliente (Prisma) e da Base de Dados (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 2. O NÚCLEO: Login e Perfis ---
enum Role {
  USER
  ADMIN
}

model Usuario {
  id                Int           @id @default(autoincrement())
  email             String        @unique
  nome              String
  sobrenome         String
  telefone          String  
  role              Role          @default(USER)
  passwordHash      String?
  oauthProvider     String?
  oauthId           String?       @unique

  // Relações 1-para-1 com os Perfis
  perfilProfessor   Professor?
  perfilEncarregado Encarregado?
  administradorEscola AdministradorEscola?

  @@map("usuarios")
}

model Professor {
  id           Int       @id @default(autoincrement())
  escolaId     Int?      // Tornar opcional para compatibilidade
  isVerificado Boolean   @default(false)
  usuarioId    Int       @unique
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  escola       Escola?   @relation(fields: [escolaId], references: [id])

  // Relações Muitos-para-Muitos (M-N)
  disciplinas Disciplina[] @relation("ProfessorDisciplinas")
  alunos      Aluno[]      @relation("ProfessorAlunos")

  @@map("professores")
}

model Encarregado {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @unique
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  alunos    Aluno[]

  @@map("encarregados")
}

model Aluno {
  id              Int       @id @default(autoincrement())
  nome            String
  sobrenome       String
  dataNascimento  DateTime? @db.Date
  classe          Int
  encarregadoId   Int
  encarregado     Encarregado @relation(fields: [encarregadoId], references: [id], onDelete: Cascade)
  professores     Professor[] @relation("ProfessorAlunos")
  chatMensagens       ChatMensagem[]
  exercicioResultados ExercicioResultado[]
  proficienciaTopicos AlunoProficienciaTopico[]

  @@map("alunos")
}

// --- 3. O CONTEÚDO: Disciplinas e Tópicos ---
model Disciplina {
  id    Int    @id @default(autoincrement())
  nome  String @unique
  professores Professor[] @relation("ProfessorDisciplinas")
  topicos     Topico[]

  @@map("disciplinas")
}

model Topico {
  id           Int    @id @default(autoincrement())
  nome         String
  nivelClasse  Int
  disciplinaId Int
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  chatMensagens       ChatMensagem[]
  exercicioResultados ExercicioResultado[]
  proficienciaTopicos AlunoProficienciaTopico[]

  @@map("topicos")
}

// --- 4. OS RESULTADOS (O Dashboard e a Adaptação) ---
enum TipoInteracaoChat {
  EXPLICACAO
  EXERCICIO
  SAUDACAO
  DESCONHECIDO
}

model ChatMensagem {
  id            Int               @id @default(autoincrement())
  timestamp     DateTime          @default(now())
  mensagemAluno String            @db.Text
  respostaIa    String            @db.Text
  tipoInteracao TipoInteracaoChat @default(DESCONHECIDO)
  alunoId       Int
  aluno         Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  topicoId      Int?
  topico        Topico?           @relation(fields: [topicoId], references: [id])

  @@map("chat_mensagens")
}

model ExercicioResultado {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  acertou      Boolean
  detalhesJson Json?
  alunoId      Int
  aluno        Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  topicoId     Int
  topico       Topico   @relation(fields: [topicoId], references: [id], onDelete: Cascade)

  @@map("exercicio_resultados")
}

enum NivelProficiencia {
  INICIANTE
  ABAIXO_MEDIA
  NA_MEDIA
  AVANCADO
  NAO_DIAGNOSTICADO
}

model AlunoProficienciaTopico {
  id       Int               @id @default(autoincrement())
  nivel    NivelProficiencia @default(NAO_DIAGNOSTICADO)
  alunoId  Int
  aluno    Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  topicoId Int
  topico   Topico            @relation(fields: [topicoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, topicoId])
  @@map("aluno_proficiencia_topicos")
}

// --- 5. NOVOS MODELOS PARA SISTEMA DE CÓDIGOS ---
model Escola {
  id          Int               @id @default(autoincrement())
  nome        String
  codigo      String?           @unique
  localizacao String?
  emailInstitucional String?
  telefoneInstitucional String?
  isVerificada Boolean          @default(false)
  ativa       Boolean           @default(true)
  
  // Documentos de verificação institucional
  documentosVerificacao DocumentoEscola[]
  
  // Relações
  administradores AdministradorEscola[]
  codigosProfessor CodigoProfessor[]
  professores     Professor[]
  
  criadoEm    DateTime          @default(now())
  atualizadoEm DateTime         @updatedAt
  
  @@map("escolas")
}

model AdministradorEscola {
  id                Int                      @id @default(autoincrement())
  usuarioId         Int                      @unique
  escolaId          Int
  isVerificado      Boolean                  @default(false)
  
  usuario           Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  escola            Escola                   @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  
  criadoEm          DateTime                 @default(now())
  atualizadoEm      DateTime                 @updatedAt
  
  @@map("administradores_escola")
}

model CodigoProfessor {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  escolaId  Int
  criadoPor Int      // Usuario ID do administrador que criou
  usadoPor  Int?     // Usuario ID que consumiu o código
  usadoEm   DateTime?
  validoAte DateTime
  isUsado   Boolean  @default(false)
  ativo     Boolean  @default(true)

  // Relações
  escola    Escola   @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  
  @@map("codigos_professor")
}

model DocumentoEscola {
  id          Int      @id @default(autoincrement())
  escolaId    Int
  tipo        String   // "alvara", "certificado_registro", "outro"
  url         String
  nomeArquivo String
  numeroDocumento String? // Número do alvará/certificado
  dataEmissao DateTime?
  dataValidade DateTime?
  aprovado    Boolean? 
  observacoes String?
  
  escola      Escola   @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now())
  aprovadoEm  DateTime?
  
  @@map("documentos_escola")
}

