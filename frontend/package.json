		"vite": "^8.0.13"
	},
	"dependencies": {
		"apexcharts": "^5.11.0",
		"axios": "^1.16.1",
		"canvas-confetti": "^1.9.4",
		"cookie": "^1.1.1",
		"lucide-svelte": "^1.0.1",
		"svelte-apexcharts": "^1.0.2"
	},
	"overrides": {
		"cookie": "^1.1.1"
